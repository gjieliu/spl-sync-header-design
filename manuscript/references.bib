  title   = {{HSTW}: A robust network flow watermarking method based on hybrid packet sequence-timing},
  journal = {Computers \& Security},
  volume  = {139},
  pages   = {103701},
  year    = {2024},
  doi     = {10.1016/j.cose.2024.103701}
}

