@article{Lindley1952,
  author    = {D. V. Lindley},
  title     = {The Theory of Queues with a Single Server},
  journal   = {Math. Proc. Cambridge Philos. Soc.},
  volume    = {48},
  number    = {2},
  pages     = {277--289},
  year      = {1952},
  doi       = {10.1017/S0305004100027638},
  abstract  = {This paper develops a general theory for the single-server queue that does not require the customary assumption of random (Poisson) arrivals. The centre of interest is the waiting times of the customers: the theory establishes the recursion relating successive waiting times and analyzes the resulting stochastic process under very general conditions on the inter-arrival and service-time distributions. The general framework unifies diverse practical applications (from Erlang's telephone-engineering origins to airport design) and specializes to the classical random-arrival results when the additional Poisson assumption is imposed.},
  verify    = {2},
}

@article{Foster1953,
  author    = {F. G. Foster},
  title     = {On the Stochastic Matrices Associated with Certain Queuing Processes},
  journal   = {Annals of Mathematical Statistics},
  volume    = {24},
  number    = {3},
  pages     = {355--360},
  year      = {1953},
  doi       = {10.1214/aoms/1177728976},
  abstract  = {The paper is concerned with an irreducible aperiodic Markov chain (``the system''), focusing on the stochastic matrices associated with certain queuing processes. General theorems are first stated which provide criteria -- based on a Lyapunov-type drift condition -- for determining whether the system is transient, recurrent-null, or ergodic (recurrent-nonnull). These criteria are then applied to the Markov chains associated with the queuing processes recently studied by D. G. Kendall; most of the results have already been obtained by Kendall using direct methods, and the main purpose of the present paper is to exhibit them as special cases of a unified drift-based theory.},
  verify    = {2},
}

@book{Meyn1993Markov,
  author    = {Sean P. Meyn and Richard L. Tweedie},
  title     = {Markov Chains and Stochastic Stability},
  publisher = {Springer-Verlag},
  address   = {London},
  year      = {1993},
  doi       = {10.1007/978-1-4471-3267-7},
  abstract  = {This monograph, published in the Communications and Control Engineering Series, develops the theory of Markov chains on general (uncountable) state spaces. The central theme is stochastic stability: the book provides a unified framework -- centered on Lyapunov drift (Foster-type) conditions -- for establishing transience, recurrence, positive recurrence, Harris recurrence, and various notions of ergodicity (ordinary, $f$-ergodicity, geometric ergodicity, $V$-uniform ergodicity). Throughout, the theory is motivated by, and applied to, models from engineering, operations research, and control theory (including nonlinear state-space models), making the book a standard reference for practitioners seeking practical methods of verifying stability of Markovian systems.},
  verify    = {2},
}

@book{Asmussen2003,
  author    = {S{\o}ren Asmussen},
  title     = {Applied Probability and Queues},
  edition   = {2},
  publisher = {Springer},
  year      = {2003},
  doi       = {10.1007/b97236},
  abstract  = {This second edition, volume 51 of the Stochastic Modelling and Applied Probability series, is a comprehensive treatment of applied probability and queueing theory. It covers Markov chains and Markov jump processes, queueing theory at the Markovian level and queueing networks, renewal theory, regenerative processes, random walks, L\'evy processes with reflection and duality, and special models including the steady-state properties of GI/G/1, Markov additive models, many-server queues, exponential change of measure (large deviations), and dams/inventories/insurance risk. Originally published by Wiley in 1987, the second edition adds a substantial amount of new material. It serves both as a graduate textbook and as a reference for researchers in applied probability and stochastic modelling.},
  verify    = {2},
}

@article{Loynes1962,
  author    = {R. M. Loynes},
  title     = {The Stability of a Queue with Non-Independent Inter-Arrival and Service Times},
  journal   = {Math. Proc. Cambridge Philos. Soc.},
  volume    = {58},
  number    = {3},
  pages     = {497--520},
  year      = {1962},
  doi       = {10.1017/S0305004100036781},
  abstract  = {The paper studies the stability of single-server queues, queues in series, and many-server queues when the inter-arrival and service times are not required to be independent. A queue is called subcritical if E(S0 - T0) > 0, critical if E(S0 - T0) = 0, and supercritical if E(S0 - T0) < 0. The main results are: (i) subcritical queues are stable; (ii) supercritical queues are unstable; (iii) critical queues may be stable, properly substable, or unstable, and are unstable whenever they are of type M (independent sequences, at least one of which is composed of mutually independent non-constant random variables). Analogous trichotomies are established for queues in series (in terms of their component queues) and for many-server queues (in terms of the consolidated queue).},
  verify    = {2},
}

@article{Kingman1970,
  author    = {J. F. C. Kingman},
  title     = {Inequalities in the Theory of Queues},
  journal   = {J. Roy. Statist. Soc. Ser. B},
  volume    = {32},
  number    = {1},
  pages     = {102--110},
  year      = {1970},
  doi       = {10.1111/j.2517-6161.1970.tb00819.x},
  abstract  = {Some simple inequalities are established for the stationary waiting time distribution in the queue GI/G/k, both for the single-server case k = 1 and for general values of k.},
  verify    = {2},
}

@book{Durrett2019,
  author    = {Rick Durrett},
  title     = {Probability: Theory and Examples},
  edition   = {5},
  publisher = {Cambridge University Press},
  year      = {2019},
  isbn      = {978-1-108-47368-4},
  abstract  = {This lively introduction to measure-theoretic probability theory covers laws of large numbers, central limit theorems, random walks, martingales, Markov chains, ergodic theorems, and Brownian motion. Concentrating on results that are the most useful for applications, this comprehensive treatment is a rigorous graduate text and reference. Operating under the philosophy that the best way to learn probability is to see it in action, the book contains extended examples that apply the theory to concrete applications. This fifth edition contains a new chapter on multidimensional Brownian motion and its relationship to partial differential equations (PDEs), an advanced topic that is finding new applications. Setting the foundation for this expansion, Chapter 7 now features a proof of It\^o's formula. Key exercises that previously were simply proofs left to the reader have been directly inserted into the text as lemmas. The new edition re-instates discussion about the central limit theorem for martingales and stationary sequences.},
  verify    = {2},
}

